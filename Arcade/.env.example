# Enhanced Arcade Terminal Environment Configuration
# =================================================
#
# This file contains configuration for the Enhanced Arcade Terminal.
# Copy this to .env and fill in your API keys for full functionality.

# OpenAI API Key (for AI assistant and intelligent features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (alternative AI provider)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI API Key (for Gemini models)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Hugging Face API Key (for open-source models)
# Get your key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Replicate API Key (for model deployment)
# Get your key from: https://replicate.com/account/api-tokens
REPLICATE_API_KEY=your_replicate_api_key_here

# Arcade Terminal Configuration
ARCADE_PORT=7681
ARCADE_HOST=0.0.0.0
ARCADE_DEBUG=true

# Learning Companion Configuration
LEARNING_API_ENABLED=true
EMOTIONAL_ADAPTATION_ENABLED=true

# Security Configuration
SANDBOX_ENABLED=true
COMMAND_TIMEOUT=30
MAX_SESSIONS=100
